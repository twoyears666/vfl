<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<!-- Virtualization.framework 的唯一门槛：没有它，VZVirtualMachineConfiguration
	     在 validate 阶段直接报 "doesn't have the entitlement"。 -->
	<key>com.apple.security.virtualization</key>
	<true/>
	<!-- 从 macOS 提取的 VZ 还会检查这几项（与 VirtualMacOniPad 一致）。 -->
	<key>com.apple.private.virtualization</key>
	<true/>
	<key>com.apple.virtualization.avp.videotoolbox</key>
	<true/>
	<key>com.apple.vm.networking</key>
	<true/>
	<!-- 自带 Hypervisor.framework 直接向内核申请虚拟化能力（VMOI 同款）。 -->
	<key>com.apple.private.hypervisor</key>
	<true/>
	<!-- 画面通过 IOSurface 在 host 与 VMM 之间传递，需要发送权限。 -->
	<key>com.apple.private.IOSurface.wiredSendRights</key>
	<true/>
	<key>com.apple.security.exception.iokit-user-client-class</key>
	<array>
		<string>IOSurfaceRootUserClient</string>
	</array>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<!-- 加载 ad-hoc 签名的第三方二进制（Hypervisor / Virtualization 之外的自带组件）。 -->
	<key>com.apple.private.amfi.can-execute-cdhash</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.private.memorystatus</key>
	<true/>
	<key>get-task-allow</key>
	<true/>
</dict>
</plist>
