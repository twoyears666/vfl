#!/bin/sh
set -e

# 虚拟机定义、磁盘、安装镜像与 socket 都放在 Media 下：CLI 与 GUI 共用，文件 App 也能看到。
data=/var/mobile/Media/VFL
legacy=/var/jb/var/mobile/Library/VFL
if [ -d "$legacy" ] && [ ! -d "$data" ]; then
	mkdir -p /var/mobile/Media
	mv "$legacy" "$data"
fi
mkdir -p "$data/vms" "$data/run" "$data/disks" "$data/images" "$data/boot" "$data/efi"
chown -R mobile:mobile "$data"
chmod 755 "$data"
chmod 775 "$data/vms" "$data/disks" "$data/boot" "$data/efi"

# App 内托管 VM（画面必须与 VZVirtualMachine 同进程），默认不启动独立 daemon，
# 否则它会先占住 socket。需要无头模式时手动 launchctl load 即可。
plist=/var/jb/Library/LaunchDaemons/com.twoyears666.vfl.daemon.plist
launchctl unload "$plist" >/dev/null 2>&1 || true

# 让主屏立刻出现图标
if [ -x /usr/bin/sbreload ]; then
	/usr/bin/sbreload >/dev/null 2>&1 || true
fi

echo "finish:restart"
